# Copiar a .env y completar. Nunca subir el .env real.

# Bot de Discord (Developer Portal → tu app → Bot / General Information)
token=""
botClientID=""
ownerID=""
prefix="="

# Lavalink. Dentro de Docker el host lo fija docker-compose ("lavalink");
# localhost sirve para correr el bot fuera de Docker.
lavalinkHost="localhost"
lavalinkPort=2333
lavalinkPassword="cambiar-esta-contraseña"  # igual a server.password de application.yml
lavalinkSecure=false

# Contraseña de yt-cipher (servidor de descifrado de YouTube).
# Igual a plugins.youtube.remoteCipher.password de application.yml
YT_CIPHER_TOKEN="cambiar-este-token"
