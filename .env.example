# Copiar a .env y completar. Nunca subir el .env real.

# Bot de Discord (Developer Portal → tu app → Bot / General Information)
token=""
botClientID=""
ownerID=""
prefix="="

# Servidor del desarrollador (clic derecho en el servidor → Copiar ID, con el modo desarrollador de Discord).
# El bot crea ahí #notificaciones-bot y avisa arranques, servidores nuevos, errores y caídas de Lavalink.
# Necesita el permiso Gestionar canales en ese servidor. Vacío = sin avisos.
DEV_GUILD_ID=""

# Lavalink. Dentro de Docker el host lo fija docker-compose ("lavalink");
# localhost sirve para correr el bot fuera de Docker.
lavalinkHost="localhost"
lavalinkPort=2333
lavalinkPassword="cambiar-esta-contraseña"  # igual a server.password de application.yml
lavalinkSecure=false

# Contraseña de yt-cipher (servidor de descifrado de YouTube).
# Igual a plugins.youtube.remoteCipher.password de application.yml
YT_CIPHER_TOKEN="cambiar-este-token"

# Versión del plugin de YouTube de Lavalink, resuelta al arrancar desde maven.lavalink.dev:
# "release" = última release estable, "dev" = último snapshot (rama de desarrollo).
# Vacío = la versión fija de application.yml.
YOUTUBE_PLUGIN_CHANNEL="dev"
